# Configuration frontend VORA (R9).
#
# Copier ce fichier en `.env` et renseigner les valeurs. `.env` est gitignore
# et ne doit JAMAIS etre commite.
#
# ⚠️ Les variables EXPO_PUBLIC_* sont embarquees dans le bundle et donc
# LISIBLES par quiconque installe l'app. On n'y met que des cles publiques a
# quota. Toute cle sensible (paiement, cle serveur) reste cote backend.

# Tuiles de carte ET geocodage (recherche de destination) — compte gratuit sur
# https://cloud.maptiler.com (100 000 chargements/mois, sans carte bancaire).
# Sans cette cle, la recherche de destination affiche son etat degrade.
EXPO_PUBLIC_MAPTILER_KEY=

# Optionnel : URL de style MapLibre complete. Si renseignee, elle prime sur la
# cle MapTiler ci-dessus. Permet de basculer sur Protomaps / OpenFreeMap sans
# toucher au code.
EXPO_PUBLIC_MAP_STYLE_URL=

# Backend VORA (non utilise tant que l'API n'existe pas).
EXPO_PUBLIC_API_URL=
